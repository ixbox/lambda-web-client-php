<?xml version="1.0"?>
<ruleset name="lambda-web-client-php">
    <description>PSR-12 coding style.</description>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <rule ref="PSR12"/>
    <!--
        PSR-12 soft line limit (120) is enforced for the library and the examples.
        Tests are excluded so that data provider rows and long assertion messages can stay on one line.
    -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>
