{
    "name": "ixbox/lambda-web-client-php",
    "description": "PHP HTTP client for AWS Lambda Web Functions with automatic SigV4 signing.",
    "type": "library",
    "keywords": [
        "aws",
        "lambda",
        "lambda-web",
        "web-functions",
        "sigv4",
        "iam",
        "http-client",
        "guzzle",
        "psr-18"
    ],
    "authors": [
        {
            "name": "ixbox"
        }
    ],
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.402",
        "guzzlehttp/guzzle": "^7.15.2",
        "guzzlehttp/promises": "^2.5",
        "guzzlehttp/psr7": "^2.13",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Ixbox\\LambdaWeb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ixbox\\LambdaWeb\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "check": [
            "@composer validate",
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite (no network, no AWS credentials).",
        "analyse": "Run PHPStan static analysis.",
        "cs": "Check coding style (PSR-12) with PHP_CodeSniffer.",
        "cs:fix": "Fix coding style automatically with phpcbf.",
        "check": "Run composer validate, coding style, static analysis and tests."
    }
}
